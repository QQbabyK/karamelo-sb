#####################################################
#               UNITS: Pa, m, s                     #
#####################################################

# ---------- 1. 材料物理参数 (Material Properties) ----------
E = 1e+6              # 
nu = 0.3              # 
K = E/(3*(1-2*nu))    # 体积模量 (Bulk Modulus, K = E / [3(1 - 2ν)])
mu = E/(2*(1+nu))     # 剪切模量/第一拉梅参数 (Shear Modulus, μ = E / [2(1 + ν)])
rho = 1050            # 
lambda = E*nu/((1+nu)*(1-2*nu)) # 第二拉梅参数 (Lame's First Parameter, λ)
c = sqrt(E/rho)       # 弹性纵波波速 (P-wave Velocity, c = √(E/ρ))

# ---------- 2. 几何与网格尺寸 (Geometry & Grid Size) ----------
L = 1                 # 悬臂梁截面边长/基准长度 (m)
A_zy = L*L            # 截面面积 (Cross-sectional Area, m^2)

alpha = 0.99          # FLIP/PIC 混合系数 (0.99 FLIP + 0.01 PIC，抑制数值噪音)

N = 20                # 跨度方向网格剖分份数
cellsize = L/N        # 背景网格尺寸 (Cell Size, m)

# ---------- 3. 计算方法与定义域 (Method & Domain) ----------
# 使用全拉格朗日物质点法 (TLMPM) + 线形插值 + FLIP 混合算法
method(tlmpm, FLIP, linear, alpha)
# 定义 3D 计算域范围: X∈[0, 4L], Y∈[0, L], Z∈[0, L], 网格步长=cellsize
dimension(3, 0, 4*L, 0, L, 0, L, cellsize)
# 定义悬臂梁几何区域 (长 4m, 宽 1m, 高 1m)
region(box, block, 0, 4*L, 0, L, 0, L)

# ---------- 4. 本构模型与质点生成 (Constitutive Model & Particles) ----------
# 定义新胡克 (Neo-Hookean) 超弹性非线性本构模型
material(mat1, neo-hookean, rho, E, nu)
# 在 box 区域填充质点，每个方向网格布置 2 个质点 (2x2x2 = 8 个/Cell)
solid(solid1, region, box, 2, mat1, cellsize, 0)

# ---------- 5. 边界条件 (Boundary Conditions) ----------
# 约束左端固持面 (X = 0 处)
region(rBCLX, block, INF, cellsize/4, INF, INF, INF, INF)
group(gBCLX, nodes, region, rBCLX, solid, solid1)
fix(fBCLX, velocity_nodes, gBCLX, 0, 0, 0) # 左端节点固定，速度 (vx, vy, vz) = (0, 0, 0)

# ---------- 6. 外力与初始条件 (Loads & Initial Conditions) ----------
# 自由端 (X = 4L 处) 施加 Y 方向集中向下载荷
region(rEND, block, 4*L-cellsize/4, INF, L-cellsize/4, INF, INF, INF)
group(gEND, nodes, region, rEND, solid, solid1)

F = -1300             # 作用力大小 (N)
fix(fEnd, force_nodes, gEND, 0, F, 0) # Y 方向施加集中力 F

N_log = 1             # 基础输出步长间隔

# ---------- 7. 数据导出设置 (Data Output) ----------
# dump_p (质点数据): 导出坐标(x,y,z)、速度(vx,vy,vz)、等效应变(seq)及全应力张量(sxx~syz)
dump(dump1, all, particle, N_log*200, dump_p.*.LAMMPS, x, y, z, vx, vy, vz, seq, s11, s22, s33, s12, s13, s23)
# dump_g (背景网格数据): 导出节点坐标与速度
dump(dump2, all, grid, N_log*200, dump_g.*.LAMMPS, x, y, z, vx, vy, vz)

# ---------- 8. 自由端顶点位移监测 (Tip Displacement Tracking) ----------
# 选取梁自由端顶角质点组
region(rTip, block, 4*L - 2*cellsize/4, INF, L-2*cellsize/4, INF, L-2*cellsize/4, INF)
group(gTip, particles, region, rTip, solid, solid1)

x_tip = xcm(gTip, x)  # 质点组形心 X 坐标
y_tip = xcm(gTip, y)  # 质点组形心 Y 坐标
z_tip = xcm(gTip, z)  # 质点组形心 Z 坐标
y0_tip = value(y_tip) # 初始 Y 坐标值
dy_tip = y_tip-y0_tip # Y 方向挠度/位移 (Δy)

# ---------- 9. 时间步长与求解控制 (Solver & Control) ----------
dt_factor(0.5)        # 时间步长 CFL 库朗数安全因子 (CFL Factor)

# 控制台日志及实时绘图输出 (显示时间与自由端挠度 dy_tip)
log_modify(custom, step, dt, time, fEnd_x, fEnd_y, fEnd_z, dy_tip)
plot(dy_tip, N_log, time, dy_tip)
set_output(N_log)

run_time(3)           # 总计算物理时间 3.0 秒